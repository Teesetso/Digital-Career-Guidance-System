// ─── Recommended course IDs (set from server-side when user has uploaded results) ───
// When you integrate with your DB/AI, pass this as an EJS variable:
// const recommendedKeys = <%- JSON.stringify(recommendedKeys || []) %>;
const recommendedKeys = []; // e.g. ["UCT-BSc Computer Science", "UP-BCom Business Management"]

// ─── RENDER ───
const tagClassMap = { science:"tag-science", arts:"tag-arts", commerce:"tag-commerce", health:"tag-health", tech:"tag-tech", law:"tag-law", edu:"tag-edu" };

function makeKey(uniId, courseName) { return `${uniId}-${courseName}`; }

function renderCourses(unis) {
    const container = document.getElementById("courseListings");
    const emptyState = document.getElementById("emptyState");
    let totalCourses = 0, totalUnis = 0;
    container.innerHTML = "";

    unis.forEach(uni => {
        if (!uni.courses.length) return;
        totalUnis++;
        totalCourses += uni.courses.length;

        const section = document.createElement("div");
        section.className = "uni-section";
        section.dataset.uniId = uni.id;

        const initials = uni.name.split(" ").filter(w => /^[A-Z]/.test(w)).slice(0,2).map(w=>w[0]).join("");
        section.innerHTML = `
            <div class="uni-header">
                <div class="uni-logo">${initials}</div>
                <div>
                    <div class="uni-name">${uni.name}</div>
                    <div class="uni-location">📍 ${uni.location}</div>
                </div>
                <span class="uni-badge">${uni.courses.length} programme${uni.courses.length!==1?"s":""}</span>
            </div>
            <div class="courses-grid">${uni.courses.map(c => courseCardHTML(uni.id, c)).join("")}</div>
        `;
        container.appendChild(section);
    });

    document.getElementById("visibleCount").textContent = totalCourses;
    document.getElementById("visibleUnis").textContent = totalUnis;
    emptyState.style.display = totalCourses === 0 ? "block" : "none";
}

function courseCardHTML(uniId, c) {
    const key = makeKey(uniId, c.name);
    const isRec = recommendedKeys.includes(key);
    const tagHTML = c.tags.map(t => `<span class="tag ${tagClassMap[t]||''}">${t}</span>`).join("");
    const reqHTML = c.requirements.map(r => `<li>${r}</li>`).join("");
    const apsBadge = c.aps > 0
        ? `<span class="aps-badge">APS ${c.aps}+</span>`
        : `<span class="aps-badge">Open Entry</span>`;

    return `
        <div class="course-card ${isRec?"recommended":""}" data-faculty="${c.faculty}" data-tags="${c.tags.join(",")}" data-name="${c.name.toLowerCase()}">
            ${isRec ? '<div class="recommended-ribbon">✅ Recommended</div>' : ""}
            <div class="course-faculty">${c.faculty}</div>
            <div class="course-name">${c.name}</div>
            <div class="course-duration">⏱ ${c.duration}</div>
            <div class="course-requirements">
                <p>Minimum Requirements</p>
                <ul>${reqHTML}</ul>
            </div>
            <div class="course-tags">${tagHTML}</div>
            <div class="card-footer">
                ${apsBadge}
                <a href="/courses/${encodeURIComponent(uniId)}/${encodeURIComponent(c.name)}" class="btn-details">View Details →</a>
            </div>
        </div>
    `;
}

// ─── FILTERING ───
function applyFilters() {
    const search = document.getElementById("searchInput").value.toLowerCase();
    const uniFilter = document.getElementById("universityFilter").value;
    const facultyFilter = document.getElementById("facultyFilter").value;
    const activeChip = document.querySelector(".chip.active")?.dataset.filter || "all";

    const filtered = universities
        .filter(uni => !uniFilter || uni.id === uniFilter)
        .map(uni => ({
            ...uni,
            courses: uni.courses.filter(c => {
                const matchSearch = !search ||
                    c.name.toLowerCase().includes(search) ||
                    c.faculty.toLowerCase().includes(search) ||
                    uni.name.toLowerCase().includes(search);
                const matchFaculty = !facultyFilter || c.faculty === facultyFilter;
                const matchChip = activeChip === "all" ||
                    (activeChip === "recommended" && recommendedKeys.includes(makeKey(uni.id, c.name))) ||
                    (activeChip === "popular" && c.aps >= 36);
                return matchSearch && matchFaculty && matchChip;
            })
        }))
        .filter(uni => uni.courses.length > 0);

    renderCourses(filtered);
}

document.getElementById("searchInput").addEventListener("input", applyFilters);
document.getElementById("universityFilter").addEventListener("change", applyFilters);
document.getElementById("facultyFilter").addEventListener("change", applyFilters);
document.querySelectorAll(".chip").forEach(chip => {
    chip.addEventListener("click", () => {
        document.querySelectorAll(".chip").forEach(c => c.classList.remove("active"));
        chip.classList.add("active");
        applyFilters();
    });
});

// Initial render
renderCourses(universities);
</script>
</body>
