<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explore Courses - DCGS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --background: #ffffff;
            --foreground: #0f172a;
            --card: #ffffff;
            --muted: #f1f5f9;
            --muted-foreground: #64748b;
            --border: #e2e8f0;
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-foreground: #ffffff;
            --success: #10b981;
            --success-light: #d1fae5;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --danger: #ef4444;
            --info: #3b82f6;
            --info-light: #dbeafe;
            --radius: 16px;
            --shadow: 0 1px 3px 0 rgba(0,0,0,0.1);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: var(--background);
            color: var(--foreground);
            line-height: 1.6;
        }

        /* ── TOP NAV ── */
        .topnav {
            background: var(--card);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow);
        }
        .topnav-brand {
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--primary);
            text-decoration: none;
        }
        .topnav-links { display: flex; gap: 1rem; align-items: center; }
        .topnav-links a {
            text-decoration: none;
            color: var(--muted-foreground);
            font-size: 0.9rem;
            font-weight: 500;
            padding: 0.4rem 0.75rem;
            border-radius: 8px;
            transition: background 0.15s, color 0.15s;
        }
        .topnav-links a:hover, .topnav-links a.active {
            background: var(--muted);
            color: var(--primary);
        }
        .topnav-links .btn-upload {
            background: var(--primary);
            color: #fff;
            padding: 0.5rem 1.25rem;
            border-radius: 10px;
        }
        .topnav-links .btn-upload:hover { background: var(--primary-dark); color: #fff; }

        /* ── LAYOUT ── */
        .page-wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* ── HERO BANNER ── */
        .hero {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%);
            border-radius: var(--radius);
            padding: 3rem 2.5rem;
            margin-bottom: 2rem;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .hero::after {
            content: '🎓';
            position: absolute;
            right: 2rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: 6rem;
            opacity: 0.15;
        }
        .hero h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
        .hero p { font-size: 1rem; opacity: 0.9; max-width: 520px; }
        .hero-badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            border: 1px solid rgba(255,255,255,0.3);
            color: #fff;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.25rem 0.75rem;
            border-radius: 99px;
            margin-bottom: 0.75rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        /* ── UPLOAD CTA (learner only) ── */
        .upload-cta {
            background: var(--info-light);
            border: 1px solid #bfdbfe;
            border-radius: var(--radius);
            padding: 1.25rem 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }
        .upload-cta p { color: #1e40af; font-weight: 500; font-size: 0.95rem; }
        .upload-cta p span { display: block; font-weight: 400; font-size: 0.85rem; color: #3b82f6; margin-top: 0.2rem; }
        .btn-primary {
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 0.65rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            white-space: nowrap;
            transition: background 0.15s, transform 0.1s;
        }
        .btn-primary:hover { background: var(--primary-dark); transform: translateY(-1px); }

        /* ── FILTERS ── */
        .filters-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
            margin-bottom: 1.75rem;
        }
        .search-box {
            flex: 1;
            min-width: 200px;
            position: relative;
        }
        .search-box input {
            width: 100%;
            padding: 0.65rem 1rem 0.65rem 2.5rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 0.9rem;
            font-family: inherit;
            background: var(--muted);
            color: var(--foreground);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .search-box input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(99,102,241,0.1); background: #fff; }
        .search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--muted-foreground); font-size: 0.9rem; }
        select.filter-select {
            padding: 0.65rem 1rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 0.875rem;
            font-family: inherit;
            background: var(--muted);
            color: var(--foreground);
            outline: none;
            cursor: pointer;
            transition: border-color 0.15s;
        }
        select.filter-select:focus { border-color: var(--primary); }
        .filter-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .chip {
            padding: 0.35rem 0.9rem;
            border-radius: 99px;
            border: 1px solid var(--border);
            background: var(--muted);
            color: var(--muted-foreground);
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s;
        }
        .chip:hover, .chip.active { background: var(--primary); color: #fff; border-color: var(--primary); }

        /* ── RESULTS COUNT ── */
        .results-meta {
            font-size: 0.875rem;
            color: var(--muted-foreground);
            margin-bottom: 1rem;
        }
        .results-meta strong { color: var(--foreground); }

        /* ── UNIVERSITY SECTIONS ── */
        .uni-section { margin-bottom: 2.5rem; }
        .uni-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--border);
        }
        .uni-logo {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--primary), #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 0.9rem;
            flex-shrink: 0;
        }
        .uni-name { font-size: 1.1rem; font-weight: 700; color: var(--foreground); }
        .uni-location { font-size: 0.8rem; color: var(--muted-foreground); }
        .uni-badge {
            margin-left: auto;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--muted-foreground);
            background: var(--muted);
            padding: 0.25rem 0.65rem;
            border-radius: 99px;
        }

        /* ── COURSE CARDS GRID ── */
        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.25rem;
        }
        .course-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.5rem;
            box-shadow: var(--shadow);
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s;
            position: relative;
            overflow: hidden;
        }
        .course-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: var(--primary); }
        .course-card.recommended { border-color: var(--success); }
        .recommended-ribbon {
            position: absolute;
            top: 0.75rem;
            right: -0.5rem;
            background: var(--success);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.2rem 1rem 0.2rem 0.75rem;
            border-radius: 4px 0 0 4px;
            letter-spacing: 0.04em;
        }
        .course-faculty {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--primary);
            margin-bottom: 0.4rem;
        }
        .course-name {
            font-size: 1rem;
            font-weight: 700;
            color: var(--foreground);
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }
        .course-duration {
            font-size: 0.8rem;
            color: var(--muted-foreground);
            margin-bottom: 0.85rem;
        }
        .course-requirements {
            background: var(--muted);
            border-radius: 8px;
            padding: 0.65rem 0.85rem;
            margin-bottom: 1rem;
        }
        .course-requirements p { font-size: 0.78rem; color: var(--muted-foreground); margin-bottom: 0.2rem; font-weight: 500; }
        .course-requirements ul { padding-left: 1rem; }
        .course-requirements li { font-size: 0.78rem; color: var(--foreground); }
        .course-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
        .tag {
            font-size: 0.72rem;
            padding: 0.2rem 0.6rem;
            border-radius: 99px;
            font-weight: 500;
        }
        .tag-science { background: #dbeafe; color: #1d4ed8; }
        .tag-arts    { background: #fce7f3; color: #be185d; }
        .tag-commerce{ background: #fef3c7; color: #92400e; }
        .tag-health  { background: #d1fae5; color: #065f46; }
        .tag-tech    { background: #ede9fe; color: #5b21b6; }
        .tag-law     { background: #fee2e2; color: #b91c1c; }
        .tag-edu     { background: #f0fdf4; color: #15803d; }
        .card-footer { display: flex; justify-content: space-between; align-items: center; }
        .aps-badge {
            font-size: 0.78rem;
            font-weight: 700;
            padding: 0.3rem 0.7rem;
            border-radius: 8px;
            background: var(--muted);
            color: var(--muted-foreground);
        }
        .aps-badge.met { background: var(--success-light); color: #065f46; }
        .btn-details {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            text-decoration: none;
            padding: 0.35rem 0.75rem;
            border-radius: 8px;
            border: 1px solid var(--primary);
            transition: background 0.15s, color 0.15s;
        }
        .btn-details:hover { background: var(--primary); color: #fff; }

        /* ── EMPTY STATE ── */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--muted-foreground);
        }
        .empty-state .icon { font-size: 3rem; margin-bottom: 1rem; }
        .empty-state h3 { font-size: 1.25rem; font-weight: 600; color: var(--foreground); margin-bottom: 0.5rem; }

        /* ── ADMIN BANNER ── */
        .admin-bar {
            background: linear-gradient(90deg, #0f172a, #1e293b);
            color: #fff;
            padding: 0.75rem 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.85rem;
        }
        .admin-bar span { opacity: 0.7; }
        .admin-bar a { color: #a5b4fc; text-decoration: none; font-weight: 600; }
        .admin-bar a:hover { color: #c7d2fe; }

        @media (max-width: 768px) {
            .page-wrap { padding: 1rem; }
            .hero { padding: 2rem 1.5rem; }
            .hero::after { display: none; }
            .filters-bar { flex-direction: column; align-items: stretch; }
            .search-box { min-width: unset; }
            .upload-cta { flex-direction: column; align-items: flex-start; }
            .courses-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
