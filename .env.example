# Database
DATABASE_URL=

# AI APIs
GROQ_API_KEY= # Get this from console.groq.com
GEMINI_API_KEY= # Get this from console.cloud.google.com
PINECONE_API_KEY=

# Email
GMAIL_USER=
GMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Session
SESSION_SECRET=

# Google OAuth (Leave blank if you aren't using "Sign in with Google" yet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pinecone
PINECONE_INDEX_NAME=

# Other
NODE_ENV=
DISABLE_CSRF=
PORT=

# JWT Secrets (You can use any long, unique, random text for these strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=
JWT_REFRESH_EXPIRY=
JWT_ACCESS_COOKIE_MAX_AGE=

# Security
BCRYPT_ROUNDS=1
OTP_EXPIRY_MINUTES=